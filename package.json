{
  "name": "still-room-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "manifest": "node scripts/generate-manifest.mjs",
    "predev": "npm run manifest",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run manifest",
    "build": "tsc --noEmit && vite build",
