    "test:pipeline": "node --test scripts/generate-manifest.test.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "gsap": "^3.13.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
